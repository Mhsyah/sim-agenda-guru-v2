# Contoh konfigurasi Agenda Guru v0.2 — salin menjadi ".env" lalu sesuaikan.
# Wizard /install dapat membuat file ini otomatis. JANGAN commit/membagikan .env.

CI_ENVIRONMENT = production

# URL lengkap aplikasi, diakhiri "/". Kosongkan untuk deteksi otomatis (tidak disarankan di produksi).
app.baseURL = "https://contoh-sekolah.sch.id/agenda/"
# true bila situs memakai HTTPS (disarankan)
app.forceGlobalSecureRequests = true
cookie.secure = true

# --- MariaDB / MySQL ---
database.default.hostname = "localhost"
database.default.database = "nama_database"
database.default.username = "user_database"
database.default.password = "password_database"
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# --- PostgreSQL (pilih salah satu engine) ---
# database.default.DBDriver = Postgre
# database.default.port = 5432
# database.default.charset = utf8
# database.default.DBCollat =

# Buat dengan: php spark key:generate --show
encryption.key =

logger.threshold = 4
